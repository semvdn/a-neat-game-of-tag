{
  "name": "a-neat-game-of-tag",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run styles && vite",
    "build": "npm run styles && vite build",
    "test": "node scripts/lab.mjs --seeds 8 --verify",
    "preview": "vite preview",
    "evaluate": "node scripts/lab.mjs",
    "experiment:train": "node scripts/train-experiment.mjs",
    "experiment:compare": "node scripts/compare-training.mjs",
    "styles": "node scripts/build-styles.mjs",
    "demo:extract": "node scripts/extract-showcase.mjs",
    "demo:dev": "npm run styles && npm run demo:extract && vite --config vite.demo.config.ts",
    "build:demo": "npm run styles && npm run demo:extract && vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "configure:github": "node scripts/configure-github.mjs",
    "check": "npm run typecheck && npm run build && npm run build:demo && npm test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.40.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.10",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "description": "Evolving pursuit and evasion with NeuroEvolution of Augmenting Topologies in an infinite procedural multi-agent game of tag.",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
