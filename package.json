{
  "name": "neat-tag-agents",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run styles && vite",
    "build": "npm run styles && vite build",
    "lint": "tsc -p tsconfig.check.json --noEmit",
    "preview": "vite preview",
    "evaluate": "node scripts/lab.mjs",
    "experiment:train": "node scripts/train-experiment.mjs",
    "experiment:compare": "node scripts/compare-training.mjs",
    "styles": "node scripts/build-styles.mjs",
    "demo:extract": "node scripts/extract-showcase.mjs",
    "demo:dev": "npm run styles && npm run demo:extract && vite --config vite.demo.config.ts",
    "build:demo": "npm run styles && npm run demo:extract && vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "configure:github": "node scripts/configure-github.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.40.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "tailwindcss": "^4.1.10"
  }
}
